<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef ParentName="InjuryBase">
    <defName>GV_ChemicalBurn</defName>
    <label>chemical burn</label>
    <labelNoun>a chemical burn</labelNoun>
    <description>A burn caused by a caustic gas.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>bandaged</labelTendedWell>
        <labelTendedWellInner>tended</labelTendedWellInner>
        <labelSolidTendedWell>tended</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>chemical burn scar</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.01875</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <canMerge>true</canMerge>
      <destroyedLabel>Dissolved</destroyedLabel>
      <destroyedOutLabel>Dissolved</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef ParentName="InjuryBase">
    <defName>GV_ShortCircuitBurn</defName>
    <label>short-circuit burn</label>
    <labelNoun>a short-circuit burn</labelNoun>
    <description>Internal damage from conductive particulate shorting out circuitry.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>patched</labelTendedWell>
        <labelTendedWellInner>patched</labelTendedWellInner>
        <labelSolidTendedWell>patched</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>fused circuitry</permanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.0125</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <canMerge>true</canMerge>
      <destroyedLabel>Burned out</destroyedLabel>
      <destroyedOutLabel>Burned out</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

</Defs>
