<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>GV_Manifold</defName>
    <label>canister manifold</label>
    <description>Racks up to four canisters and feeds their gas into whichever gas network it is configured for. A pawn must reconfigure it (a short job, like flicking a switch) to change which gas it accepts; any stored gas is vented and any racked canisters are ejected when it does. Haulers bring full canisters automatically, and drained canisters come back out as empty shells. If destroyed, the stored gas bursts out.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/GasVentilation/GV_Manifold</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.45</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <tickerType>Rare</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>30</Mass>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>GV_GasVentilation</li>
    </researchPrerequisites>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="GasVentilation.CompProperties_GasManifold">
        <!-- Placeholder only: VEF's own ConfigErrors requires a non-null pipeNet on the shared def-level
             Props. The real, active pipeNet is set per-instance at runtime (see CompGasManifold), so this
             value is never actually used for registration. -->
        <pipeNet>GV_Net_Toxin</pipeNet>
        <storageCapacity>4</storageCapacity>
        <addTransferGizmo>false</addTransferGizmo>
        <refillOptions>
          <ratio>1</ratio>
        </refillOptions>
      </li>
    </comps>
  </ThingDef>

</Defs>
