<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>GV_IntruderSensor</defName>
    <label>intruder sensor</label>
    <description>A wall-mounted motion and thermal sensor. While armed and powered, it opens every sensor-controlled gas vent in its room when chosen targets enter, and closes them again after they leave. It can also lock any powered door linked to it for as long as it stays triggered. It does not work in rooms open to the map edge.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Never</tickerType>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/GasVentilation/GV_IntruderSensor</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- See GV_VentMounted in GasVents.xml: vanilla's 0.9-cell wall-attachment offset is tuned for a thin
           object like a torch; our chunkier sensor box fills most of its canvas, so 0.9 pushed it deep past
           the wall's near edge with a visible gap instead of sitting flush against it. -->
      <drawOffsetNorth>(0,0,0.5)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.5)</drawOffsetSouth>
      <!-- East/west art is narrower and anchored further toward the canvas edge (~36% fill starting at 63%
           across) than north/south (~80% fill starting at 0%). 0.4 sits flush at the wall's near edge; pulled
           back further to 0.3 so the sensor visibly protrudes into the room. -->
      <drawOffsetWest>(-0.1,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.1,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>2</Mass>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>30</basePowerConsumption>
      </li>
      <li Class="GasVentilation.CompProperties_IntruderSensor" />
    </comps>
    <designationCategory>Security</designationCategory>
    <researchPrerequisites>
      <li>GV_GasVentilation</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <inspectorTabs>
      <li>GasVentilation.ITab_GasSensor</li>
    </inspectorTabs>
  </ThingDef>
</Defs>
