<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Bases ===================== -->

  <ThingDef ParentName="BuildingBase" Name="GV_VentBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Never</tickerType>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <designationCategory>Security</designationCategory>
    <designatorDropdown>GV_Dropdown_Vents</designatorDropdown>
    <researchPrerequisites>
      <li>GV_GasVentilation</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <constructEffect>ConstructMetal</constructEffect>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
  </ThingDef>

  <!-- Replaces a wall cell (vanilla Vent rules); blows into the cell it faces. -->
  <ThingDef ParentName="GV_VentBase" Name="GV_VentWallBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <blockWeather>true</blockWeather>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <holdsRoof>true</holdsRoof>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <placeWorkers>
      <li>GasVentilation.PlaceWorker_GasVentOutput</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
      <isAirtight>true</isAirtight>
    </building>
  </ThingDef>

  <!-- Hangs on an existing wall (vanilla wall attachment, like the wall lamp); blows into its own cell. -->
  <ThingDef ParentName="GV_VentBase" Name="GV_VentMountedBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
  </ThingDef>

  <!-- Hangs from the roof above; drawn over pawns; falls when the roof is removed. -->
  <ThingDef ParentName="GV_VentBase" Name="GV_VentCeilingBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <terrainAffordanceNeeded IsNull="True" />
    <clearBuildingArea>false</clearBuildingArea>
    <blocksAltitudes>
      <li>MoteOverheadLow</li>
    </blocksAltitudes>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <placeWorkers>
      <li>GasVentilation.PlaceWorker_UnderRoof</li>
    </placeWorkers>
  </ThingDef>

  <!-- Walkable floor grate; blows into its own cell; no furniture on top. -->
  <ThingDef ParentName="GV_VentBase" Name="GV_VentFloorBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- ===================== Toxin ===================== -->

  <ThingDef ParentName="GV_VentWallBase">
    <defName>GV_VentWall_Toxin</defName>
    <label>toxin wall vent</label>
    <description>Replaces a wall section and blows toxin gas into the room it faces. Connects to toxin gas pipes on any side, including hidden pipes under the neighbouring walls.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentWall/GV_VentWall_Toxin</texPath>
    </graphicData>
    <comps>
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Toxin</pipeNet>
        <gas>GV_Gas_Toxin</gas>
        <outputOffset>(0,0,1)</outputOffset>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="GV_VentMountedBase">
    <defName>GV_VentMounted_Toxin</defName>
    <label>toxin wall-mounted vent</label>
    <description>A vent mounted on an existing wall that releases toxin gas into the room. Connect it with a hidden toxin pipe under the wall it hangs on, or a pipe beside it.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentMounted/GV_VentMounted_Toxin</texPath>
    </graphicData>
    <comps>
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Toxin</pipeNet>
        <gas>GV_Gas_Toxin</gas>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="GV_VentCeilingBase">
    <defName>GV_VentCeiling_Toxin</defName>
    <label>toxin ceiling vent</label>
    <description>A vent hung from the ceiling that releases toxin gas into the room below. Must be built under a roof, and falls if the roof is removed. Connect it with toxin pipes in neighbouring cells.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentCeiling/GV_VentCeiling_Toxin</texPath>
    </graphicData>
    <comps>
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Toxin</pipeNet>
        <gas>GV_Gas_Toxin</gas>
        <requiresRoof>true</requiresRoof>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="GV_VentFloorBase">
    <defName>GV_VentFloor_Toxin</defName>
    <label>toxin floor vent</label>
    <description>A walkable floor grate that releases toxin gas. Connect it with hidden toxin pipes under the floor next to it.</description>
