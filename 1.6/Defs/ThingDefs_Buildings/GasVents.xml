<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Bases ===================== -->

  <ThingDef ParentName="BuildingBase" Name="GV_VentBase" Abstract="True">
    <thingClass>GasVentilation.Building_GasVent</thingClass>
    <category>Building</category>
    <tickerType>Never</tickerType>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <designationCategory>Security</designationCategory>
    <researchPrerequisites>
      <li>GV_GasVentilation</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <constructEffect>ConstructMetal</constructEffect>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>25</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Toxin</pipeNet>
        <gas>GV_Gas_Toxin</gas>
      </li>
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Sedative</pipeNet>
        <gas>GV_Gas_Sedative</gas>
      </li>
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Haywire</pipeNet>
        <gas>GV_Gas_Haywire</gas>
      </li>
      <li Class="GasVentilation.CompProperties_GasVent">
        <pipeNet>GV_Net_Insecticide</pipeNet>
        <gas>GV_Gas_Insecticide</gas>
      </li>
    </comps>
  </ThingDef>

  <!-- Replaces a wall cell (vanilla Vent rules); blows into the cell it faces. -->
  <ThingDef ParentName="GV_VentBase">
    <defName>GV_VentWall</defName>
    <label>gas wall vent</label>
    <description>Replaces a wall section and blows gas into the room it faces, for whichever gas(es) it is switched to output. Connects to gas pipes on any side, including hidden pipes under the neighbouring walls.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentWall/GV_VentWall</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <blockWeather>true</blockWeather>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <holdsRoof>true</holdsRoof>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <placeWorkers>
      <li>GasVentilation.PlaceWorker_GasVentOutput</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
      <isAirtight>true</isAirtight>
    </building>
    <comps Inherit="True">
      <li Class="GasVentilation.CompProperties_GasVentController">
        <outputOffset>(0,0,1)</outputOffset>
      </li>
    </comps>
  </ThingDef>

  <!-- Hangs on an existing wall (vanilla wall attachment, like the wall lamp); blows into its own cell. -->
  <ThingDef ParentName="GV_VentBase">
    <defName>GV_VentMounted</defName>
    <label>gas wall-mounted vent</label>
    <description>A vent mounted on an existing wall that releases gas into the room, for whichever gas(es) it is switched to output. Connect it with a hidden pipe under the wall it hangs on, or a pipe beside it.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentMounted/GV_VentMounted</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Vanilla's wall-attachment offset of 0.9 cells is tuned for a thin object like a torch; our
           chunkier vent fills most of its canvas, so 0.9 pushed it deep past the wall's near edge with a
           visible gap instead of sitting flush against it. North/south sit flush at 0.5; east/west are
           pulled back a bit further so the vent visibly protrudes into the room. -->
      <drawOffsetNorth>(0,0,0.5)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.5)</drawOffsetSouth>
      <drawOffsetWest>(-0.2,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.2,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps Inherit="True">
      <li Class="GasVentilation.CompProperties_GasVentController" />
    </comps>
  </ThingDef>

  <!-- Hangs from the roof above; drawn over pawns; falls when the roof is removed. -->
  <ThingDef ParentName="GV_VentBase">
    <defName>GV_VentCeiling</defName>
    <label>gas ceiling vent</label>
    <description>A vent hung from the ceiling that releases gas into the room below, for whichever gas(es) it is switched to output. Must be built under a roof, and falls if the roof is removed. Connect it with gas pipes in neighbouring cells.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentCeiling/GV_VentCeiling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <terrainAffordanceNeeded IsNull="True" />
    <clearBuildingArea>false</clearBuildingArea>
    <blocksAltitudes>
      <li>MoteOverheadLow</li>
    </blocksAltitudes>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <placeWorkers>
      <li>GasVentilation.PlaceWorker_UnderRoof</li>
    </placeWorkers>
    <comps Inherit="True">
      <li Class="GasVentilation.CompProperties_GasVentController">
        <requiresRoof>true</requiresRoof>
      </li>
    </comps>
  </ThingDef>

  <!-- Walkable floor grate; blows into its own cell; no furniture on top. -->
  <ThingDef ParentName="GV_VentBase">
    <defName>GV_VentFloor</defName>
    <label>gas floor vent</label>
    <description>A walkable floor grate that releases gas, for whichever gas(es) it is switched to output. Connect it with hidden pipes under the floor next to it.</description>
    <graphicData>
      <texPath>Things/Building/GasVentilation/VentFloor/GV_VentFloor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps Inherit="True">
      <li Class="GasVentilation.CompProperties_GasVentController" />
    </comps>
  </ThingDef>

</Defs>
