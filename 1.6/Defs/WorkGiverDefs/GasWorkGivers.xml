<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorkGiverDef>
    <defName>GV_ReconfigureManifold</defName>
    <label>reconfigure gas manifold</label>
    <giverClass>GasVentilation.WorkGiver_ReconfigureManifold</giverClass>
    <verb>reconfigure</verb>
    <gerund>reconfiguring</gerund>
    <workType>BasicWorker</workType>
    <priorityInType>50</priorityInType>
    <scanThings>true</scanThings>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>
  <WorkGiverDef>
    <defName>GV_DoBillsGasCompounder</defName>
    <label>make things at gas compounder</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Smithing</workType>
    <priorityInType>75</priorityInType>
    <fixedBillGiverDefs>
      <li>GV_GasCompounder</li>
    </fixedBillGiverDefs>
    <verb>work at</verb>
    <gerund>working at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
  <WorkGiverDef>
    <defName>GV_RefillManifold</defName>
    <label>refill gas manifold</label>
    <giverClass>GasVentilation.WorkGiver_RefillManifold</giverClass>
    <verb>refill</verb>
    <gerund>refilling</gerund>
    <workType>Hauling</workType>
    <priorityInType>50</priorityInType>
    <scanThings>true</scanThings>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>
</Defs>
